{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:primary-capability-baseline:shared-domain-projection:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "bundle_id",
    "domain_vocabulary",
    "episodes",
    "capabilities",
    "claim_versions",
    "source_records",
    "recorded_support_assessments",
    "recorded_action_grants",
    "domain_mandate_records",
    "declaration_records",
    "use_records",
    "ledger_observations",
    "closure_attestations",
    "observable_external_facts"
  ],
  "properties": {
    "format_version": {
      "const": "EH-G0-A2-SHARED-0.1"
    },
    "bundle_id": {
      "$ref": "#/$defs/D001"
    },
    "domain_vocabulary": {
      "$ref": "#/$defs/D013"
    },
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/D014"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/D015"
      }
    },
    "claim_versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/D016"
      }
    },
    "source_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/D017"
      }
    },
    "recorded_support_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/D018"
      }
    },
    "recorded_action_grants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/D019"
      }
    },
    "domain_mandate_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/D020"
      }
    },
    "declaration_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/D021"
      }
    },
    "use_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/D022"
      }
    },
    "ledger_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/D023"
      }
    },
    "closure_attestations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/D024"
      }
    },
    "observable_external_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/D025"
      }
    }
  },
  "$defs": {
    "D001": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,95}$"
    },
    "D002": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "D003": {
      "type": "string",
      "pattern": "^CAP_[0-9A-F]{24}$"
    },
    "D004": {
      "type": "string",
      "pattern": "^STANDING_[0-9A-F]{24}$"
    },
    "D005": {
      "type": "string",
      "pattern": "^AUTHZ_[0-9A-F]{24}$"
    },
    "D006": {
      "type": "string",
      "pattern": "^ACTION_[0-9A-F]{24}$"
    },
    "D007": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0][1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "D008": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/D001"
      }
    },
    "D009": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "D010": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "D011": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_from",
        "effective_until"
      ],
      "properties": {
        "effective_from": {
          "$ref": "#/$defs/D007"
        },
        "effective_until": {
          "$ref": "#/$defs/D007"
        }
      }
    },
    "D012": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
      "id": {
        "$ref": "#/$defs/D001"
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "attributes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      }
    },
    "D013": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vocabulary_id",
        "vocabulary_version",
        "domain_id",
        "canonicalization_method_ref",
        "selector_language_id",
        "purpose_entries",
        "scope_entries"
      ],
      "properties": {
        "vocabulary_id": {
          "$ref": "#/$defs/D001"
        },
        "vocabulary_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "domain_id": {
          "$ref": "#/$defs/D001"
        },
        "canonicalization_method_ref": {
          "type": "string",
          "minLength": 1
        },
        "selector_language_id": {
          "const": "EH-SELECTOR-CORE-0_1"
        },
        "purpose_entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/D012"
          }
        },
        "scope_entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/D012"
          }
        }
      }
    },
    "D014": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_party_episode_id",
        "episode_family_id",
        "sender_capability_id",
        "receiver_capability_id",
        "sender_role_id",
        "receiver_role_id",
        "purpose_id",
        "scope_id",
        "interval",
        "domain_vocabulary_ref"
      ],
      "properties": {
        "cross_party_episode_id": {
          "$ref": "#/$defs/D001"
        },
        "episode_family_id": {
          "$ref": "#/$defs/D001"
        },
        "sender_capability_id": {
          "$ref": "#/$defs/D001"
        },
        "receiver_capability_id": {
          "$ref": "#/$defs/D001"
        },
        "sender_role_id": {
          "$ref": "#/$defs/D001"
        },
        "receiver_role_id": {
          "$ref": "#/$defs/D001"
        },
        "purpose_id": {
          "$ref": "#/$defs/D001"
        },
        "scope_id": {
          "$ref": "#/$defs/D001"
        },
        "interval": {
          "$ref": "#/$defs/D011"
        },
        "domain_vocabulary_ref": {
          "$ref": "#/$defs/D001"
        }
      }
    },
    "D015": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "episode_id",
        "role_id"
      ],
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/D003"
        },
        "episode_id": {
          "$ref": "#/$defs/D001"
        },
        "role_id": {
          "$ref": "#/$defs/D001"
        }
      }
    },
    "D016": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_claim_version_id",
        "claim_id",
        "version",
        "payload",
        "source_record_refs"
      ],
      "properties": {
        "exact_claim_version_id": {
          "$ref": "#/$defs/D001"
        },
        "claim_id": {
          "$ref": "#/$defs/D001"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_record_refs": {
          "$ref": "#/$defs/D009"
        },
        "corrects_exact_claim_version_id": {
          "$ref": "#/$defs/D001"
        }
      }
    },
    "D017": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_id",
        "source_kind",
        "observed_at",
        "payload"
      ],
      "properties": {
        "source_record_id": {
          "$ref": "#/$defs/D001"
        },
        "source_kind": {
          "enum": [
            "DOCUMENT",
            "MESSAGE",
            "DECISION_LOG",
            "POLICY",
            "SYSTEM_EVENT"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/D007"
        },
        "payload": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "predecessor_ref": {
          "$ref": "#/$defs/D001"
        }
      }
    },
    "D018": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_assessment_id",
        "exact_claim_version_id",
        "assessment",
        "evidence_refs",
        "recorded_at",
        "assessor_capability_id"
      ],
      "properties": {
        "support_assessment_id": {
          "$ref": "#/$defs/D001"
        },
        "exact_claim_version_id": {
          "$ref": "#/$defs/D001"
        },
        "assessment": {
          "enum": [
            "SUPPORTED",
            "NOT_SUPPORTED",
            "UNRESOLVED"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/D009"
        },
        "recorded_at": {
          "$ref": "#/$defs/D007"
        },
        "assessor_capability_id": {
          "$ref": "#/$defs/D001"
        }
      }
    },
    "D019": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_grant_id",
        "issuer_capability_id",
        "subject_capability_id",
        "action_or_decision_ref",
        "purpose_id",
        "scope_id",
        "decision",
        "interval",
        "policy_ref"
      ],
      "properties": {
        "action_grant_id": {
          "$ref": "#/$defs/D005"
        },
        "issuer_capability_id": {
          "$ref": "#/$defs/D001"
        },
        "subject_capability_id": {
          "$ref": "#/$defs/D001"
        },
        "action_or_decision_ref": {
          "$ref": "#/$defs/D006"
        },
        "purpose_id": {
          "$ref": "#/$defs/D001"
        },
        "scope_id": {
          "$ref": "#/$defs/D001"
        },
        "decision": {
          "enum": [
            "PERMIT",
            "DENY",
            "UNRESOLVED"
          ]
        },
        "interval": {
          "$ref": "#/$defs/D011"
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "D020": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandate_version_ref",
        "subject_capability_id",
        "permitted_record_kinds",
        "purpose_ids",
        "scope_ids",
        "interval",
        "policy_ref"
      ],
      "properties": {
        "mandate_version_ref": {
          "$ref": "#/$defs/D004"
        },
        "subject_capability_id": {
          "$ref": "#/$defs/D001"
        },
        "permitted_record_kinds": {
          "$ref": "#/$defs/D008"
        },
        "purpose_ids": {
          "$ref": "#/$defs/D008"
        },
        "scope_ids": {
          "$ref": "#/$defs/D008"
        },
        "interval": {
          "$ref": "#/$defs/D011"
        },
        "policy_ref": {
          "const": "POLICY_SHARED_0_1"
        }
      }
    },
    "D021": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_version_ref",
        "declaration_kind",
        "issuer_capability_id",
        "receiver_capability_id",
        "episode_id",
        "exact_claim_version_id",
        "purpose_id",
        "scope_id",
        "recorded_at",
        "interval",
        "mandate_version_ref",
        "standing_basis_ref",
        "policy_ref"
      ],
      "properties": {
        "declaration_version_ref": {
          "$ref": "#/$defs/D001"
        },
        "declaration_kind": {
          "enum": [
            "ADOPTION_DECLARED",
            "INTENDED_USE_DECLARED",
            "DELEGATION_DECLARED",
            "DECLARATION_WITHDRAWN",
            "DECLARATION_REPLACED"
          ]
        },
        "issuer_capability_id": {
          "$ref": "#/$defs/D001"
        },
        "receiver_capability_id": {
          "$ref": "#/$defs/D001"
        },
        "delegate_capability_id": {
          "$ref": "#/$defs/D001"
        },
        "grant_id": {
          "$ref": "#/$defs/D001"
        },
        "standing_basis_ref": {
          "$ref": "#/$defs/D001"
        },
        "episode_id": {
          "$ref": "#/$defs/D001"
        },
        "exact_claim_version_id": {
          "$ref": "#/$defs/D001"
        },
        "purpose_id": {
          "$ref": "#/$defs/D001"
        },
        "scope_id": {
          "$ref": "#/$defs/D001"
        },
        "recorded_at": {
          "$ref": "#/$defs/D007"
        },
        "effective_at": {
          "$ref": "#/$defs/D007"
        },
        "interval": {
          "$ref": "#/$defs/D011"
        },
        "mandate_version_ref": {
          "$ref": "#/$defs/D001"
        },
        "policy_ref": {
          "$ref": "#/$defs/D001"
        },
        "target_declaration_family": {
          "enum": [
            "ADOPTION_OR_INTENDED_USE",
            "DELEGATION"
          ]
        },
        "target_declaration_version_ref": {
          "$ref": "#/$defs/D001"
        },
        "replacement_declaration_version_ref": {
          "$ref": "#/$defs/D001"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "declaration_kind": {
                "enum": [
                  "ADOPTION_DECLARED",
                  "INTENDED_USE_DECLARED"
                ]
              }
            },
            "required": [
              "declaration_kind"
            ]
          },
          "then": {
            "required": [
              "standing_basis_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "declaration_kind": {
                "const": "DELEGATION_DECLARED"
              }
            },
            "required": [
              "declaration_kind"
            ]
          },
          "then": {
            "required": [
              "delegate_capability_id",
              "grant_id",
              "standing_basis_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "declaration_kind": {
                "const": "DECLARATION_WITHDRAWN"
              }
            },
            "required": [
              "declaration_kind"
            ]
          },
          "then": {
            "required": [
              "effective_at",
              "target_declaration_family",
              "target_declaration_version_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "declaration_kind": {
                "const": "DECLARATION_REPLACED"
              }
            },
            "required": [
              "declaration_kind"
            ]
          },
          "then": {
            "required": [
              "effective_at",
              "target_declaration_family",
              "target_declaration_version_ref",
              "replacement_declaration_version_ref"
            ]
          }
        }
      ]
    },
    "D022": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_id",
        "episode_id",
        "exact_claim_version_id",
        "receiver_capability_id",
        "purpose_id",
        "scope_id",
        "occurred_at",
        "declared_basis_refs",
        "decision_context_ref",
        "action_or_decision_ref"
      ],
      "properties": {
        "use_id": {
          "$ref": "#/$defs/D001"
        },
        "episode_id": {
          "$ref": "#/$defs/D001"
        },
        "exact_claim_version_id": {
          "$ref": "#/$defs/D001"
        },
        "receiver_capability_id": {
          "$ref": "#/$defs/D001"
        },
        "purpose_id": {
          "$ref": "#/$defs/D001"
        },
        "scope_id": {
          "$ref": "#/$defs/D001"
        },
        "occurred_at": {
          "$ref": "#/$defs/D007"
        },
        "declared_basis_refs": {
          "$ref": "#/$defs/D008"
        },
        "decision_context_ref": {
          "$ref": "#/$defs/D001"
        },
        "action_or_decision_ref": {
          "$ref": "#/$defs/D006"
        }
      }
    },
    "D023": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_context_ref",
        "ledger_id",
        "committed_frontier",
        "captured_at",
        "included_record_refs",
        "nonce",
        "action_or_decision_ref"
      ],
      "properties": {
        "decision_context_ref": {
          "$ref": "#/$defs/D001"
        },
        "ledger_id": {
          "$ref": "#/$defs/D001"
        },
        "committed_frontier": {
          "type": "integer",
          "minimum": 0
        },
        "captured_at": {
          "$ref": "#/$defs/D007"
        },
        "included_record_refs": {
          "$ref": "#/$defs/D010"
        },
        "nonce": {
          "$ref": "#/$defs/D001"
        },
        "action_or_decision_ref": {
          "$ref": "#/$defs/D006"
        }
      }
    },
    "D024": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closure_attestation_id",
        "ledger_id",
        "committed_frontier",
        "source_extent",
        "closed_record_classes",
        "closed_through",
        "verification_method_ref"
      ],
      "properties": {
        "closure_attestation_id": {
          "$ref": "#/$defs/D001"
        },
        "ledger_id": {
          "$ref": "#/$defs/D001"
        },
        "committed_frontier": {
          "type": "integer",
          "minimum": 0
        },
        "source_extent": {
          "$ref": "#/$defs/D008"
        },
        "closed_record_classes": {
          "$ref": "#/$defs/D008"
        },
        "closed_through": {
          "$ref": "#/$defs/D007"
        },
        "verification_method_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "D025": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_fact_id",
        "observed_at",
        "fact"
      ],
      "properties": {
        "external_fact_id": {
          "$ref": "#/$defs/D001"
        },
        "observed_at": {
          "$ref": "#/$defs/D007"
        },
        "fact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  }
}
